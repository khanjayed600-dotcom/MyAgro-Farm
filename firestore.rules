rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null &&
         request.auth.token.email in ['khanjayed600@gmail.com', 'admin@myagrofarm.com', 'ceo@myagrofarm.com'])
      );
    }

    // Validation for new Order creation
    function isValidOrder(data) {
      return data.keys().hasAll(['orderNumber', 'customerName', 'customerPhone', 'deliveryAddress', 'items', 'total', 'status']) &&
        data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 64 &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() >= 10 && data.customerPhone.size() <= 20 &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
        data.total is number && data.total >= 0 &&
        data.status in ['Pending', 'Confirmed', 'Processing', 'Packed', 'Shipped', 'Out for Delivery', 'Delivered', 'Cancelled', 'Return Requested', 'Refunded'];
    }

    // Orders Collection
    match /orders/{orderId} {
      // Document ID validation
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Public / Customer order creation (any device can place an order)
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().status == 'Pending';

      // Only authorized administrators can update order status, timeline, or notes
      allow update: if isValidId(orderId) && isAdmin();

      // Only administrators can remove records
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Admins Collection
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Customer Complaints Collection
    match /complaints/{complaintId} {
      allow create: if isValidId(complaintId);
      allow read, update, delete: if isAdmin();
    }

    // Product Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
